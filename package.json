{
  "name": "lime-csr-js",
  "version": "0.6.3",
  "description": "An HTML-first client-side rendering engine built with standard browser APIs.",
  "type": "module",
  "main": "src/index.js",
  "unpkg": "dist/index.min.js",
  "jsdelivr": "dist/index.min.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./core": {
      "default": "./src/core/index.js"
    },
    "./modules": {
      "default": "./src/modules/index.js"
    },
    "./modules/*": {
      "default": "./src/modules/*.js"
    },
    "./dist": "./dist/index.min.js",
    "./dist/*": "./dist/*"
  },
  "files": [
    "src/",
    "dist/",
    "DOCS.md",
    "LICENCE.md"
  ],
  "keywords": [
    "html-first",
    "client-side-rendering",
    "reactive",
    "no-build"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhmtsnmzkanly/lime-csr-js.git"
  },
  "bugs": {
    "url": "https://github.com/mhmtsnmzkanly/lime-csr-js/issues"
  },
  "homepage": "https://github.com/mhmtsnmzkanly/lime-csr-js#readme",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "prepack": "npm run build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test",
    "test:browser": "node --test test/browser-smoke.test.js",
    "test:csp": "node scripts/check-csp.js",
    "benchmark": "node scripts/benchmark.js",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.7.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2"
  }
}
